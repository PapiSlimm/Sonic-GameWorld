# Production env template. Every secret-shaped value below is a placeholder — set the real value
# once in your platform's secret store (Render env var group with `sync: false`, or GCP Secret
# Manager via infrastructure/terraform) and never in a committed file. See render.yaml's
# `gameworld-secrets` env var group and infrastructure/terraform/secrets.tf for where these
# ultimately live for each deploy target.

NODE_ENV=production
API_PORT=4000
API_HOST=0.0.0.0
API_BASE_URL=https://marketplace.sonicgameworld.com
# ^ Stripe Checkout success/cancel redirect base — a marketplace app URL, not the API's own. See
#   integrations/stripe/README.md and the root README's cross-package notes.

# ---- Auth ----
JWT_SECRET=SET-IN-SECRET-MANAGER-OR-RENDER-ENV-GROUP   # boot fails without a strong value when NODE_ENV=production (see services/api/src/config.ts)
JWT_ISSUER=sonic-gameworld
JWT_EXPIRES_IN=1h
JWT_EXPIRES_IN_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30
API_KEY_PREFIX=gw_live_

# ---- Database ----
DATABASE_URL=SET-BY-PLATFORM   # Render: fromDatabase (render.yaml); GCP: see infrastructure/terraform/outputs.tf

# ---- Redis / event bus ----
REDIS_URL=SET-BY-PLATFORM      # Render: fromService (render.yaml); GCP: `terraform output redis_host` (+ TLS/auth — see cloud_run.tf's rediss:// construction)
EVENT_BUS_DRIVER=redis         # `pubsub` on the GCP path — see infrastructure/terraform/pubsub.tf's design note before assuming per-EventType topics

# ---- Object storage — services/api and workers/* read DIFFERENT env var names for the same
# credentials (S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY/S3_PUBLIC_URL_BASE vs.
# S3_ACCESS_KEY/S3_SECRET_KEY/CDN_BASE_URL) — both are set here, same values, so every service
# resolves correctly. See integrations/storage/README.md. ----
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=gameworld-assets-prod
S3_ACCESS_KEY_ID=SET-IN-SECRET-MANAGER-OR-RENDER-ENV-GROUP
S3_SECRET_ACCESS_KEY=SET-IN-SECRET-MANAGER-OR-RENDER-ENV-GROUP
S3_ACCESS_KEY=SET-IN-SECRET-MANAGER-OR-RENDER-ENV-GROUP
S3_SECRET_KEY=SET-IN-SECRET-MANAGER-OR-RENDER-ENV-GROUP
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_URL_BASE=https://cdn.sonicgameworld.com
CDN_BASE_URL=https://cdn.sonicgameworld.com

# ---- Search ----
OPENSEARCH_URL=
SEARCH_INDEX=gameworld

# ---- Payments — LIVE Stripe keys. See integrations/stripe/README.md + connect-onboarding.md. ----
STRIPE_SECRET_KEY=SET-IN-SECRET-MANAGER-OR-RENDER-ENV-GROUP
STRIPE_WEBHOOK_SECRET=SET-IN-SECRET-MANAGER-OR-RENDER-ENV-GROUP
STRIPE_CONNECT_CLIENT_ID=SET-IN-SECRET-MANAGER-OR-RENDER-ENV-GROUP

# ---- AI ----
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=SET-IN-SECRET-MANAGER-OR-RENDER-ENV-GROUP
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
GEMINI_API_KEY=SET-IN-SECRET-MANAGER-OR-RENDER-ENV-GROUP
GEMINI_MODEL=gemini-1.5-pro
AI_MODEL_DEFAULT=claude-sonnet-4-5
AI_EMBEDDING_MODEL=text-embedding-004
AI_GENERATION_PROVIDER=anthropic

# ---- Firebase — see integrations/identity/firebase-setup.md ----
FIREBASE_PROJECT_ID=sonic-gameworld
FIREBASE_SERVICE_ACCOUNT_JSON=SET-IN-SECRET-MANAGER-OR-RENDER-ENV-GROUP
FIREBASE_SERVICE_ACCOUNT_PATH=

# ---- Worker concurrency / behavior — tune up from staging's once real traffic volume is known ----
STORAGE_DRIVER=s3
ASSET_WORKER_CONCURRENCY=4
AUTO_APPROVE_ASSETS=false
THUMBNAIL_WORKER_CONCURRENCY=4
THUMBNAIL_CARD_SIZE_PX=512
BUILD_WORKER_CONCURRENCY=2
MODERATION_WORKER_CONCURRENCY=4
MODERATION_REQUIRE_REVIEW_FOR_LOW=true
ANALYTICS_WORKER_CONCURRENCY=4
REPUTATION_LOOKBACK_DAYS=90
AI_GENERATION_WORKER_CONCURRENCY=4

# ---- Misc ----
LOG_LEVEL=info
CORS_ORIGIN=https://studio.sonicgameworld.com,https://marketplace.sonicgameworld.com,https://play.sonicgameworld.com,https://creator.sonicgameworld.com,https://admin.sonicgameworld.com,https://developer.sonicgameworld.com
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
GCP_PROJECT_ID=sonic-gameworld-prod
PUBSUB_TOPIC_PREFIX=gameworld
KAFKA_BROKERS=
MAPTILER_KEY=SET-IN-SECRET-MANAGER-OR-RENDER-ENV-GROUP
OPENTOPO_KEY=SET-IN-SECRET-MANAGER-OR-RENDER-ENV-GROUP
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=SET-IN-SECRET-MANAGER-OR-RENDER-ENV-GROUP

# ---- Frontends ----
NEXT_PUBLIC_API_URL=https://api.sonicgameworld.com
NEXT_PUBLIC_WS_URL=wss://api.sonicgameworld.com
NEXT_PUBLIC_CDN_BASE_URL=https://cdn.sonicgameworld.com
NEXT_PUBLIC_STUDIO_URL=https://studio.sonicgameworld.com
NEXT_PUBLIC_MARKETPLACE_URL=https://marketplace.sonicgameworld.com
NEXT_PUBLIC_DEVELOPER_PORTAL_URL=https://developer.sonicgameworld.com
