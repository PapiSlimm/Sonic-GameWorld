# Local development env template. Copy to the repo root as `.env` for `docker compose up -d` +
# `pnpm dev` (see the root README's quickstart). Every value here is a working local default —
# nothing needs to be filled in to get the whole stack running against docker-compose.yml.
#
# See infrastructure/environments/README.md for how this differs from staging/prod, and for the
# cross-package env var naming notes referenced throughout (marked inline below too).

# ---- Core ----
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
API_BASE_URL=http://localhost:3001
# ^ services/api/src/config.ts uses this to build Stripe Checkout success/cancel redirect URLs
#   (`${API_BASE_URL}/checkout/success`), which are MARKETPLACE app routes — point it at the
#   marketplace app's URL, not the API's own. See integrations/stripe/README.md.

# ---- Auth ----
JWT_SECRET=dev-insecure-secret-change-me
JWT_ISSUER=sonic-gameworld
JWT_EXPIRES_IN=1h
JWT_EXPIRES_IN_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30
API_KEY_PREFIX=gw_live_

# ---- Database ----
DATABASE_URL=postgresql://gameworld:gameworld@localhost:5432/gameworld?schema=public

# ---- Redis / event bus ----
REDIS_URL=redis://localhost:6379
EVENT_BUS_DRIVER=memory
# `memory` (single-process, no cross-service delivery) is the right default for `pnpm dev`, where
# every service runs in one machine's separate processes anyway and most local iteration doesn't
# need cross-process event delivery. Switch to `redis` (below) to exercise the real fan-out path.
# EVENT_BUS_DRIVER=redis

# ---- Object storage (MinIO via docker-compose.yml) ----
# services/api reads the S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY / S3_PUBLIC_URL_BASE names;
# workers/* read S3_ACCESS_KEY / S3_SECRET_KEY / CDN_BASE_URL instead — a real naming mismatch
# between those two packages (not a typo here), so both are set to the same MinIO credentials.
# See infrastructure/storage/../README and the root README's cross-package notes.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east1
S3_BUCKET=gameworld-assets
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL_BASE=http://localhost:9000/gameworld-assets
CDN_BASE_URL=http://localhost:9000/gameworld-assets

# ---- Search (optional — falls back to Postgres ILIKE when unset) ----
OPENSEARCH_URL=
SEARCH_INDEX=gameworld

# ---- Payments (unset = MockProvider, real Stripe Checkout never called) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# ---- AI ----
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
AI_MODEL_DEFAULT=claude-sonnet-4-5
AI_EMBEDDING_MODEL=text-embedding-004
AI_GENERATION_PROVIDER=anthropic
# ^ Unset ANTHROPIC_API_KEY/GEMINI_API_KEY -> the `mock` AI provider is used everywhere (see
#   CONTRACTS.md §8) — the AI Director/NPC/asset-generation paths all work with zero API keys.

# ---- Firebase (unset = use POST /v1/auth/dev instead; see integrations/identity) ----
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=

# ---- Worker concurrency / behavior (all optional, safe local defaults) ----
STORAGE_DRIVER=s3
ASSET_WORKER_CONCURRENCY=2
AUTO_APPROVE_ASSETS=true
THUMBNAIL_WORKER_CONCURRENCY=2
THUMBNAIL_CARD_SIZE_PX=512
BUILD_WORKER_CONCURRENCY=1
MODERATION_WORKER_CONCURRENCY=2
MODERATION_REQUIRE_REVIEW_FOR_LOW=false
ANALYTICS_WORKER_CONCURRENCY=2
REPUTATION_LOOKBACK_DAYS=90
AI_GENERATION_WORKER_CONCURRENCY=2

# ---- Misc ----
LOG_LEVEL=debug
CORS_ORIGIN=*
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
GCP_PROJECT_ID=
PUBSUB_TOPIC_PREFIX=gameworld
KAFKA_BROKERS=
MAPTILER_KEY=
OPENTOPO_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# ---- Frontends (Next.js — NEXT_PUBLIC_* are baked in at build time, see infrastructure/docker/web.Dockerfile) ----
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_CDN_BASE_URL=http://localhost:9000/gameworld-assets
NEXT_PUBLIC_STUDIO_URL=http://localhost:3000
NEXT_PUBLIC_MARKETPLACE_URL=http://localhost:3001
NEXT_PUBLIC_DEVELOPER_PORTAL_URL=http://localhost:3005
