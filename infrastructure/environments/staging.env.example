# Staging env template. Same shape as prod.env.example (real managed Postgres/Redis/storage, real
# secrets) at smaller scale, so staging catches config/infra problems before they reach prod.
#
# NODE_ENV NOTE: services/api/src/config.ts's env schema only accepts NODE_ENV in
# {development, test, production} — there is no dedicated "staging" value. This template sets
# `production` so staging exercises the same code paths prod does (dev-login disabled, JWT_SECRET
# strength check enforced, production log level) rather than accidentally being closer to a dev
# build. If your team wants `POST /v1/auth/dev` available on staging for QA convenience, that
# requires NODE_ENV=development instead — you cannot have both dev-login *and* the
# production-only safety checks with the current enum; that's a gap in services/api's config
# schema, not something this env file can work around.
NODE_ENV=production
API_PORT=4000
API_HOST=0.0.0.0
API_BASE_URL=https://marketplace.staging.sonicgameworld.com

# ---- Auth ----
JWT_SECRET=SET-IN-SECRET-MANAGER-OR-RENDER-ENV-GROUP   # must be a strong random value — see NODE_ENV note above (checked at boot when NODE_ENV=production)
JWT_ISSUER=sonic-gameworld
JWT_EXPIRES_IN=1h
JWT_EXPIRES_IN_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30
API_KEY_PREFIX=gw_test_

# ---- Database (managed Postgres — Render or Cloud SQL, see render.yaml / infrastructure/terraform) ----
DATABASE_URL=SET-BY-PLATFORM   # Render: fromDatabase; GCP: from `terraform output database_private_ip` + db_user/db_name

# ---- Redis / event bus ----
REDIS_URL=SET-BY-PLATFORM      # Render: fromService; GCP: from `terraform output redis_host`
EVENT_BUS_DRIVER=redis         # `pubsub` on the GCP path — see infrastructure/terraform's cloud_run.tf

# ---- Object storage — see the dev template's note on the S3_* naming mismatch between
# services/api and workers/*; both naming conventions are set to the same staging bucket/keys. ----
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=gameworld-assets-staging
S3_ACCESS_KEY_ID=SET-IN-SECRET-MANAGER-OR-RENDER-ENV-GROUP
S3_SECRET_ACCESS_KEY=SET-IN-SECRET-MANAGER-OR-RENDER-ENV-GROUP
S3_ACCESS_KEY=SET-IN-SECRET-MANAGER-OR-RENDER-ENV-GROUP
S3_SECRET_KEY=SET-IN-SECRET-MANAGER-OR-RENDER-ENV-GROUP
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_URL_BASE=https://cdn.staging.sonicgameworld.com
CDN_BASE_URL=https://cdn.staging.sonicgameworld.com

# ---- Search ----
OPENSEARCH_URL=
SEARCH_INDEX=gameworld-staging

# ---- Payments — use real Stripe TEST-mode keys (sk_test_/whsec_ from `stripe listen`
# or a staging-specific webhook endpoint), never live keys, on staging. ----
STRIPE_SECRET_KEY=SET-IN-SECRET-MANAGER-OR-RENDER-ENV-GROUP
STRIPE_WEBHOOK_SECRET=SET-IN-SECRET-MANAGER-OR-RENDER-ENV-GROUP
STRIPE_CONNECT_CLIENT_ID=SET-IN-SECRET-MANAGER-OR-RENDER-ENV-GROUP

# ---- AI ----
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=SET-IN-SECRET-MANAGER-OR-RENDER-ENV-GROUP
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
AI_MODEL_DEFAULT=claude-sonnet-4-5
AI_EMBEDDING_MODEL=text-embedding-004
AI_GENERATION_PROVIDER=anthropic

# ---- Firebase — a real Firebase project (can be a separate one from prod, or the same project
# with a staging-only sign-in provider config) — see integrations/identity/firebase-setup.md. ----
FIREBASE_PROJECT_ID=sonic-gameworld-staging
FIREBASE_SERVICE_ACCOUNT_JSON=SET-IN-SECRET-MANAGER-OR-RENDER-ENV-GROUP
FIREBASE_SERVICE_ACCOUNT_PATH=

# ---- Worker concurrency / behavior ----
STORAGE_DRIVER=s3
ASSET_WORKER_CONCURRENCY=2
AUTO_APPROVE_ASSETS=false
THUMBNAIL_WORKER_CONCURRENCY=2
THUMBNAIL_CARD_SIZE_PX=512
BUILD_WORKER_CONCURRENCY=1
MODERATION_WORKER_CONCURRENCY=2
MODERATION_REQUIRE_REVIEW_FOR_LOW=true
ANALYTICS_WORKER_CONCURRENCY=2
REPUTATION_LOOKBACK_DAYS=90
AI_GENERATION_WORKER_CONCURRENCY=2

# ---- Misc ----
LOG_LEVEL=info
CORS_ORIGIN=https://studio.staging.sonicgameworld.com,https://marketplace.staging.sonicgameworld.com,https://play.staging.sonicgameworld.com,https://creator.staging.sonicgameworld.com,https://admin.staging.sonicgameworld.com,https://developer.staging.sonicgameworld.com
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
GCP_PROJECT_ID=sonic-gameworld-staging
PUBSUB_TOPIC_PREFIX=gameworld-staging
KAFKA_BROKERS=
MAPTILER_KEY=SET-IN-SECRET-MANAGER-OR-RENDER-ENV-GROUP
OPENTOPO_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=SET-IN-SECRET-MANAGER-OR-RENDER-ENV-GROUP

# ---- Frontends ----
NEXT_PUBLIC_API_URL=https://api.staging.sonicgameworld.com
NEXT_PUBLIC_WS_URL=wss://api.staging.sonicgameworld.com
NEXT_PUBLIC_CDN_BASE_URL=https://cdn.staging.sonicgameworld.com
NEXT_PUBLIC_STUDIO_URL=https://studio.staging.sonicgameworld.com
NEXT_PUBLIC_MARKETPLACE_URL=https://marketplace.staging.sonicgameworld.com
NEXT_PUBLIC_DEVELOPER_PORTAL_URL=https://developer.staging.sonicgameworld.com
