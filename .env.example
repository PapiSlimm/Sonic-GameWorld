# ---- Core ----
NODE_ENV=development
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# ---- Data layer ----
DATABASE_URL=postgresql://gameworld:gameworld@localhost:5432/gameworld?schema=public
REDIS_URL=redis://localhost:6379
OPENSEARCH_URL=http://localhost:9200

# ---- Object storage (S3-compatible: GCS, MinIO, R2, S3) ----
# services/api also accepts the longer S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY/S3_PUBLIC_URL_BASE
# names (whichever is set wins) — the short names below are what every worker package and this
# file use, so they're the ones to set.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east1
S3_BUCKET=gameworld-assets
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
CDN_BASE_URL=http://localhost:9000/gameworld-assets

# ---- Event bus: memory | redis | pubsub | kafka ----
EVENT_BUS_DRIVER=redis
GCP_PROJECT_ID=
PUBSUB_TOPIC_PREFIX=gameworld
KAFKA_BROKERS=

# ---- Auth ----
JWT_SECRET=change-me-to-a-64-char-random-string
JWT_ISSUER=sonic-gameworld
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---- Payments ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# ---- AI ----
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AI_MODEL_DEFAULT=claude-sonnet-4-5
AI_EMBEDDING_MODEL=text-embedding-004

# ---- Geo / WorldForge ----
MAPTILER_KEY=
OPENTOPO_KEY=

# ---- Observability ----
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# ---- Frontends (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_CDN_BASE_URL=http://localhost:9000/gameworld-assets
